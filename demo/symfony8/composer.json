{
    "name": "nowo-tech/mail-kit-demo-symfony8",
    "description": "Mail Kit Bundle demo (Symfony 8, FrankenPHP, MySQL, Mailpit)",
    "type": "project",
    "license": "MIT",
    "require": {
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.0",
        "nowo-tech/doctrine-encrypt-bundle": "^2.9",
        "nowo-tech/form-kit-bundle": "^2.17",
        "nowo-tech/instance-settings-bundle": "^1.1",
        "nowo-tech/mail-kit-bundle": "@dev",
        "nowo-tech/ui-kit-bundle": "^2.20",
        "php": ">=8.4,<8.6",
        "symfony/clock": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/flex": "^2.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12"
    },
    "require-dev": {
        "nowo-tech/hot-reload-bundle": "^1.4",
        "nowo-tech/twig-inspector-bundle": "*",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/debug-bundle": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "test": "phpunit",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "/var/mail-kit-bundle",
            "options": {
                "symlink": true
            }
        }
    ]
}
