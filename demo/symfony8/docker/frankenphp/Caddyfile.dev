{
	order mercure after encode
	skip_install_trust
	# REQ-RUNTIME-001 timeout hierarchy: DNS lookup of a DSN host (2 s, nowo_mail_kit.dsn.dns_timeout) and Resend key
	# check (10 s, resend.api_timeout) < PHP max_execution_time (30 s) < Caddy write timeout (40 s). max_wait_time caps
	# the wait for a free PHP thread (503 instead of an endless queue).
	servers {
		timeouts {
			write 40s
		}
	}
	frankenphp {
		php_ini max_execution_time 30
		php_ini max_input_time 30
		max_wait_time 10s
	}
}

:80 {
	root * /app/public
	encode zstd br gzip
	# Disable cache in development so changes are reflected immediately
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header Pragma "no-cache"
	# Classic mode (no worker): each request runs in a new PHP process so the app always responds and file changes are visible
	mercure {
		anonymous
	}

	php_server {
		hot_reload
	}
}
