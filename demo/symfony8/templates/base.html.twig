{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The Instance Settings and MailKit pages render in it too
    (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Mail Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Mail Kit Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Mail Kit Bundle">
            <a class="nowo-ui-link" href="{{ path('nowo_instance_settings_section', {section: 'mailer'}) }}"{% if _route starts with 'nowo_instance_settings' %} aria-current="page"{% endif %}>Mailer settings</a>
            <a class="nowo-ui-link" href="{{ path('nowo_mail_kit_log') }}"{% if _route starts with 'nowo_mail_kit' %} aria-current="page"{% endif %}>Sent mail</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent mailer fields, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
{% endblock %}
