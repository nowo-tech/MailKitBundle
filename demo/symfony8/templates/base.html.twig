{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). The Instance Settings and MailKit pages render in it too
    (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Mail Kit',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/MailKitBundle',
    translation_domain: false,
    nav: [
        {label: 'Home', route: 'demo_home', section: 'Demo'},
        {label: 'Mailer settings', route: 'nowo_instance_settings_section', params: {section: 'mailer'}, active: ['nowo_instance_settings_*'], section: 'Mail Kit admin'},
        {label: 'Sent mail', route: 'nowo_mail_kit_log', active: ['nowo_mail_kit_*'], section: 'Mail Kit admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Mail Kit Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent mailer fields, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
{% endblock %}
