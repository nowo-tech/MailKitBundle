{% extends 'base.html.twig' %}

{% block title %}Home - Mail Kit Demo{% endblock %}

{% block body %}
{% set status = nowo_mail_kit_status() %}
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h2>Runtime mailer</h2></div>
    <div class="nowo-ui-card__body">
        <p>
            The mailer DSN, sender and test recipient are edited in <strong>Settings → Mailer</strong> (Instance Settings):
            the DSN is encrypted at rest and every <code class="nowo-ui-code">MailerInterface::send()</code> resolves it at runtime;
            <code class="nowo-ui-code">MAILER_DSN</code> is only the fallback.
        </p>
        <dl  data-testid="demo-status">
            <dt>Transport</dt><dd><code class="nowo-ui-code">{{ status.label }}</code> ({{ status.source.value }})</dd>
            <dt>Outbound mail ready</dt><dd  data-testid="demo-ready">{{ nowo_mail_kit_outbound_mail_ready() ? 'yes' : 'no' }}</dd>
            <dt>FrankenPHP mode</dt><dd>worker by default (<code class="nowo-ui-code">FRANKENPHP_MODE</code>)</dd>
        </dl>
    </div>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h3>Send a message</h3></div>
    <div class="nowo-ui-card__body">
        {{ form_start(form) }}
            {% for child in form %}
                {% if not child.rendered %}{{ form_row(child) }}{% endif %}
            {% endfor %}
        {{ form_end(form) }}
    </div>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h3>Manage</h3></div>
    <div class="nowo-ui-card__body">
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_instance_settings_section', {section: 'mailer'}) }}">Mailer settings</a>
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_mail_kit_log') }}">Sent-mail log</a>
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="http://localhost:8087" target="_blank" rel="noopener">Mailpit</a>
        <p>MailKit 1.3 upgrade path: store the settings as 1.2 left them, then open the mailer settings.</p>
        {{ form_start(legacy) }}{{ form_rest(legacy) }}{{ form_end(legacy) }}
    </div>
</div>
{% endblock %}
