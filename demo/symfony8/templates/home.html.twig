{% extends 'base.html.twig' %}

{% block title %}Home - Mail Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Mail Kit demo',
        intro: 'The mailer DSN, sender and test recipient are edited at runtime in the settings; every MailerInterface::send() resolves them.',
    }) }}
{% endblock %}

{% block body %}
    {% set status = nowo_mail_kit_status() %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Runtime mailer', intro: 'The DSN is encrypted at rest; MAILER_DSN is only the fallback.', kind: 'detail', status: status} %}
        {% block section_body %}
            <dl data-testid="demo-status">
                <dt>Transport</dt><dd><code class="nowo-ui-code">{{ status.label }}</code> ({{ status.source.value }})</dd>
                <dt>Outbound mail ready</dt><dd data-testid="demo-ready">{{ nowo_mail_kit_outbound_mail_ready() ? 'yes' : 'no' }}</dd>
                <dt>FrankenPHP mode</dt><dd>worker by default (<code class="nowo-ui-code">FRANKENPHP_MODE</code>)</dd>
            </dl>
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_instance_settings_section', {section: 'mailer'}) }}">Mailer settings</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_mail_kit_log') }}">Sent-mail log</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="http://localhost:8087" target="_blank" rel="noopener">Mailpit</a>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Send a message', kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-send-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'send' %}{{ form_row(child) }}{% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}{{ form_widget(form.send, {attr: {form: 'demo-send-form', class: 'nowo-ui-btn nowo-ui-btn--primary', 'data-testid': 'demo-send'}}) }}{% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'MailKit 1.3 upgrade path', intro: 'Store the settings as 1.2 left them, then open the mailer settings.', kind: 'content', legacy: legacy} %}
        {% block section_body %}
            {{ form_start(legacy) }}{{ form_rest(legacy) }}{{ form_end(legacy) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
