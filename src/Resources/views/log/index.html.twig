{#
  Sent-mail log list (REQ-UI-003): UiKit list scaffold. Variables: page (Nowo\UiKitBundle\View\ListPage from
  Ui\AdminPages::listPage(): header with the redacted current transport, GET filters (search, status, period), table,
  "View" row action, pagination, empty state), filters (Log\SentMailFilters). This template fills only the row cells.

  Override: a template that extends '@!NowoMailKitBundle/log/index.html.twig' (web_ui.templates.log_index) and
  overrides nowo_ui_list_row (or another scaffold data block). Restyle through nowo_ui_kit.theme (slots), never here.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_list_row %}
    {%- set _b = page.bundle -%}
    {%- set _cell = nowo_ui_class('table_cell', _b) -%}
    {%- set _status = row.status.value -%}
    {%- set _status_slot = _status == 'failed' ? 'badge_danger' : (_status == 'queued' ? 'badge_info' : 'badge_success') -%}
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'log.column.queued_at'|trans({}, 'NowoMailKitBundle') }}" data-required="1">
        <time datetime="{{ row.queuedAt|date('c') }}">{{ row.queuedAt|date('Y-m-d H:i:s') }}</time>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'log.column.status'|trans({}, 'NowoMailKitBundle') }}">
        <span class="{{ nowo_ui_class(_status_slot, _b) }}" data-testid="mail-kit-status">{{ ('log.status.' ~ _status)|trans({}, 'NowoMailKitBundle') }}</span>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'log.column.subject'|trans({}, 'NowoMailKitBundle') }}">
        <a href="{{ path('nowo_mail_kit_log_show', {id: row.id}) }}">{{ row.subject ?: '—' }}</a>
    </td>
    <td class="{{ _cell }}{{ row.to is empty ? ' ' ~ nowo_ui_class('table_cell_muted', _b) }} nowo-ui-cell--start" data-label="{{ 'log.column.to'|trans({}, 'NowoMailKitBundle') }}" data-nowo-ui-priority="2">
        {{ row.to is empty ? '—' : row.to|join(', ') }}
    </td>
    <td class="{{ _cell }}{{ row.tag ? '' : ' ' ~ nowo_ui_class('table_cell_muted', _b) }} nowo-ui-cell--start" data-label="{{ 'log.column.tag'|trans({}, 'NowoMailKitBundle') }}" data-nowo-ui-priority="3">
        {%- if row.tag -%}<code class="{{ nowo_ui_class('code', _b) }}">{{ row.tag }}</code>{%- else -%}—{%- endif -%}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'log.column.transport'|trans({}, 'NowoMailKitBundle') }}" data-nowo-ui-priority="3">
        <code class="{{ nowo_ui_class('code', _b) }}">{{ row.transport ?: '—' }}</code>
    </td>
{% endblock %}
